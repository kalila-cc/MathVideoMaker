  "title": "Paimon.moe character-event five-star pity aggregate (community-submitted records)",
  "source": {
    "article_title": "Genshin Impact pity system: an analysis",
    "article_author": "MsExcel",
    "article_url": "https://www.hoyolab.com/article/39564924",
